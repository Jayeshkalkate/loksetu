# Copy to .env and fill in. Never commit .env.

# --- Django ---------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# Leave unset/False in production. Use DEBUG=True only on your own machine.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://your-app.onrender.com  (Render's hostname is added automatically)
CSRF_TRUSTED_ORIGINS=
# Reverse proxies in front of the app (Render/Heroku = 1). Used for per-IP rate limits.
NUM_PROXIES=1

# --- Database ---------------------------------------------------------------
# Leave blank for local SQLite. Production: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=

# --- Uploaded evidence ----------------------------------------------------------
# Directory for complaint evidence. On hosts with an ephemeral disk, mount a persistent
# disk and point this at it (e.g. /var/data/media).
MEDIA_ROOT=

# --- Email (password reset + complaint status updates) -------------------------------
# Leave EMAIL_HOST_USER blank to print emails to the console instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Site details (all optional; empty links are hidden) ------------------------------
CONTACT_EMAIL=
LINKEDIN_URL=
PORTFOLIO_URL=
GITHUB_URL=
INSTAGRAM_URL=

# --- Monitoring (optional) ------------------------------------------------------
SENTRY_DSN=
