# Copy this file to .env for local development. Replace SECRET_KEY before deployment.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-development-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False
# Optional contact details / outbound links
CONTACT_EMAIL=
LINKEDIN_URL=
PORTFOLIO_URL=
GITHUB_URL=
INSTAGRAM_URL=
# Optional email delivery (leave blank to use the console email backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Optional production configuration
# DATABASE_URL=postgres://user:password@host:5432/loksetu
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# MEDIA_ROOT=/path/to/persistent/media
